            },
            "author_association": "MEMBER",
            "body": "this is the same setup as the existing test: https://github.com/neovim/neovim/blob/c696bab8475a80aa49295b3c9e6d1a18d1332f0e/test/functional/plugin/lsp/semantic_tokens_spec.lua#L159\n\n\ncan we just add an extra assert to it? suggestion (untested): \n\n```diff\ndiff --git i/test/functional/plugin/lsp/semantic_tokens_spec.lua w/test/functional/plugin/lsp/semantic_tokens_spec.lua\nindex 22fc95c41622..5d2de4e64058 100644\n--- i/test/functional/plugin/lsp/semantic_tokens_spec.lua\n+++ w/test/functional/plugin/lsp/semantic_tokens_spec.lua\n@@ -182,7 +182,7 @@ describe('semantic token highlighting', function()\n         local bufnr = vim.api.nvim_get_current_buf()\n         vim.api.nvim_win_set_buf(0, bufnr)\n         vim.bo[bufnr].filetype = 'some-filetype'\n-        _G._start_server(_G.server2)\n+        _G.test_client_id = _G._start_server(_G.server2)\n       end)\n \n       screen:expect {\n@@ -203,6 +203,32 @@ describe('semantic token highlighting', function()\n                                                 |\n       ]],\n       }\n+\n+      -- fileformat=dos\n+      exec_lua(function()\n+        assert(vim.lsp.get_client_by_id(assert(_G.test_client_id))):stop()\n+        vim.bo[bufnr].fileformat = 'dos'\n+        _G._start_server(_G.server2)\n+      end)\n+\n+      screen:expect {\n+        grid = [[\n+        #include <iostream>                     |\n+                                                |\n+        int main()                              |\n+        {                                       |\n+            int x;                              |\n+        {2:#ifdef __cplusplus}                      |\n+        {2:    std::cout << x << \"\\n\";}             |\n+        {2:#else}                                   |\n+        {2:    printf(\"%d\\n\", x);}                  |\n+        {2:#e}ndif                                  |\n+        }                                       |\n+        ^}                                       |\n+        {1:~                                       }|*3\n+                                                |\n+      ]],\n+      }\n     end)\n \n     it('calls both range and full when range is supported', function()\n```",
