            },
            "author_association": "MEMBER",
            "body": "this test passes on master. that's the risk with assertions that test \"nothing happened\", and why it's always preferable, if possible to test actual state.",
            "commit_id": "e6cf7d6ed18a9442186e874f32d4d07979c998e4",
            "created_at": "2026-08-07T15:45:09Z",
            "diff_hunk": "@@ -3659,6 +3659,22 @@ describe('progress-message', function()\n     }, 'Progress autocmd receives progress messages')\n   end)\n \n+  it(':read does not emit bufwrite progress', function()\n+    local fname = 'Xread_progress_test'\n+\n+    fn.writefile({ 'hello' }, fname)\n+    finally(function()\n+      os.remove(fname)\n+    end)\n+\n+    setup_autocmd('nvim.bufwrite')\n+\n+    command('read ' .. fname)\n+\n+    assert_progress_autocmd(nil,\n+      ':read should not emit bufwrite progress events')",
