            "author_association": "NONE",
            "body": "## CodeQL / Potentially overflowing call to snprintf\n\nThe [size argument](1) of this snprintf call is derived from its return value, which may exceed the size of the buffer and overflow.\n\n[Show more details](https://github.com/neovim/neovim/security/code-scanning/123)",
            "commit_id": "eb0249430ebd9e1793e8b1949c0084a02ba63c2b",
            "created_at": "2026-10-17T08:02:51Z",
            "diff_hunk": "@@ -2132,14 +2147,83 @@\n   hlgp->sg_blend = -1;\n   hlgp->sg_name_u = arena_memdupz(&highlight_arena, name, len);\n   hlgp->sg_parent = scoped_parent;\n+  hlgp->sg_hidden = hidden;\n   // will get set to false by caller if settings are added\n   hlgp->sg_cleared = true;\n   vim_strup(hlgp->sg_name_u);\n \n   int id = highlight_ga.ga_len;  // ID is index plus one\n \n-  map_put(cstr_t, int)(&highlight_unames, hlgp->sg_name_u, id);\n+  if (!hidden) {\n+    map_put(cstr_t, int)(&highlight_unames, hlgp->sg_name_u, id);\n+  }\n+\n+  return id;\n+}\n+\n+/// Defines hidden group \"idx\" from resolved attrs. Unlike set_hl_group() this does not request a\n+/// redraw.\n+static void hl_define_from_attrs(int idx, HlAttrs attrs)\n+{\n+  HlGroup *g = &hl_table[idx];\n+  g->sg_cleared = false;\n+  g->sg_gui = attrs.rgb_ae_attr & ~HL_DEFAULT;\n+  g->sg_rgb_fg = attrs.rgb_fg_color;\n+  g->sg_rgb_bg = attrs.rgb_bg_color;\n+  g->sg_rgb_sp = attrs.rgb_sp_color;\n+  // set_hl_attr() only uses a color if its index is set.\n+  g->sg_rgb_fg_idx = attrs.rgb_fg_color >= 0 ? kColorIdxHex : kColorIdxNone;\n+  g->sg_rgb_bg_idx = attrs.rgb_bg_color >= 0 ? kColorIdxHex : kColorIdxNone;\n+  g->sg_rgb_sp_idx = attrs.rgb_sp_color >= 0 ? kColorIdxHex : kColorIdxNone;\n+  g->sg_cterm = attrs.cterm_ae_attr & ~HL_DEFAULT;\n+  g->sg_cterm_fg = attrs.cterm_fg_color;\n+  g->sg_cterm_bg = attrs.cterm_bg_color;\n+  g->sg_cterm_bold = g->sg_cterm & HL_BOLD;\n+  g->sg_blend = attrs.hl_blend;\n+  XFREE_CLEAR(g->sg_font);\n+  if (attrs.font >= 0) {\n+    g->sg_font = xstrdup(hl_get_font(attrs.font));\n+  }\n+  set_hl_attr(idx);\n+}\n+\n+/// Returns a hidden highlight group representing a stack of groups combined with \"%$\".\n+/// The group is named by joining the stacked groups' names with \"+\", e.g. \"User1+User2\",\n+/// and is not discoverable by name or listed among highlight groups. Its attributes are\n+/// updated from `attr` on every call. Groups representing the same stack are reused.\n+///\n+/// @param ids  ids of the stacked groups, first to last\n+/// @param n  number of ids, from two to MAX_HL_STACK\n+/// @param attr  attr of the stacked groups combined\n+/// @return id of the group, or of the last stacked group if no group could be added\n+int syn_stack_group(const int *ids, int n, int attr)\n+  FUNC_ATTR_NONNULL_ALL\n+{\n+  assert(n > 1 && n <= MAX_HL_STACK);\n+  // Identify the stack by ids, a name can be truncated. An id has at most 5 digits, so the ids and\n+  // separators of MAX_HL_STACK groups need 6 bytes each, including the NUL.\n+  STATIC_ASSERT(MAX_HL_ID < 100000, \"key too small for highlight ids\");\n+  char key[6 * MAX_HL_STACK];\n+  size_t klen = 0;\n+  for (int i = 0; i < n; i++) {\n+    klen += (size_t)snprintf(key + klen, sizeof(key) - klen, i ? \",%d\" : \"%d\", ids[i]);",
