    "comment_regular_data": [
        {
            "author_association": "MEMBER",
            "body": "Just a heads-up: this change broke Gitsigns' nightly CI.\r\n\r\n`vim.opt.diffopt:get()` used to return a list, but now returns a map. Gitsigns still reads it as a list, so it ends up seeing no diff options and falls back to external Git diffs.\r\n\r\nWill update Gitsigns to handle the new format, but wanted to mention the downstream breakage here.\r\n\r\n~~Maybe consider marking this as a breaking change in news?~~",
            "created_at": "2026-08-11T13:09:37Z",
