            "author_association": "MEMBER",
            "body": "perf regression: this `M.dir(p)` does a full `uv.fs_scandir` and discards it on every `test(p)` call. This path is used by `vim.fs.root()` and plugins doing `find({'.git'}, {upward=true})`.  each parent directory now does a full directory scan. \n\n\n```suggestion\n        local ok, base_err = uv.fs_access(p, 'R')\n```",
            "commit_id": "517a9f5ad1d5d8343684621e13f322f4ac7c3c90",
            "created_at": "2026-07-01T08:17:04Z",
            "diff_hunk": "@@ -342,16 +386,29 @@ function M.find(names, opts)\n     if type(names) == 'function' then\n       test = function(p)\n         local t = {}\n-        for name, type in M.dir(p) do\n+        local it, base_err = M.dir(p)\n+        if base_err ~= nil then\n+          table.insert(errors, { path = p, err = base_err })\n+        end\n+        for name, type, err in it do\n+          local f = M.joinpath(p, name)\n+          if err ~= nil then\n+            table.insert(errors, { path = f, err = err })\n+          end\n           if (not opts.type or opts.type == type) and names(name, p) then\n-            table.insert(t, M.joinpath(p, name))\n+            table.insert(t, f)\n           end\n         end\n         return t\n       end\n     else\n       test = function(p)\n         local t = {} --- @type string[]\n+        local _, base_err = M.dir(p)",
