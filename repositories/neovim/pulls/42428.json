            "body": "Suggested patch LGTM:\n\n\n<details>\n<summary>patch</summary>\n\n\n```diff\n--- a/runtime/lua/nvim/autoread.lua\n+++ b/runtime/lua/nvim/autoread.lua\n@@ -8,7 +8,7 @@\n local M = {}\n\n local debounce_ms = 100\n---- @type table<integer, fun()> bufnr -> cancel function\n+--- @type table<integer, { path: string, cancel: fun() }> bufnr -> watched file\n local watchers = {}\n --- @type table<integer, uv.uv_timer_t> bufnr -> debounce timer\n local timers = {}\n@@ -27,9 +27,9 @@\n\n --- @private\n --- @param bufnr integer\n---- @return boolean\n-function M._is_watching(bufnr)\n-  return watchers[bufnr] ~= nil\n+--- @return string? path Watched file, if any.\n+function M._watched_path(bufnr)\n+  return watchers[bufnr] and watchers[bufnr].path\n end\n\n --- Sets the 'busy' option on a `pending` buffer. Idempotent: if `pending` and `pending_busy`\n@@ -100,9 +100,9 @@\n --- @param bufnr integer\n local function stop_watcher(bufnr)\n   set_pending(bufnr, false)\n-  local cancel = watchers[bufnr]\n-  if cancel then\n-    cancel()\n+  local watcher = watchers[bufnr]\n+  if watcher then\n+    watcher.cancel()\n     watchers[bufnr] = nil\n   end\n   local timer = timers[bufnr]\n@@ -160,7 +160,7 @@\n     end)\n   end)\n\n-  watchers[bufnr] = cancel\n+  watchers[bufnr] = { path = name, cancel = cancel }\n end\n\n function M.enable()\n--- a/test/functional/options/autoread_spec.lua\n+++ b/test/functional/options/autoread_spec.lua\n@@ -10,14 +10,18 @@\n local write_file = t.write_file\n local sleep = vim.uv.sleep\n\n---- Returns true if the autoread module is watching the given buffer\n+--- Returns the file the autoread module watches for the given buffer\n --- (defaults to the current buffer).\n-local function is_watching(bufnr)\n+local function watched_path(bufnr)\n   return n.exec_lua(function(b)\n-    return require('nvim.autoread')._is_watching(b or vim.api.nvim_get_current_buf())\n+    return require('nvim.autoread')._watched_path(b or vim.api.nvim_get_current_buf())\n   end, bufnr)\n end\n\n+local function is_watching(bufnr)\n+  return watched_path(bufnr) ~= nil\n+end\n+\n --- Shortens the 'autoread' debounce window so each test doesn't pay the 100ms time-cost.\n local function shorten_debounce()\n   n.exec_lua([[require('nvim.autoread')._set_debounce(10)]])\n@@ -127,22 +131,13 @@\n       eq({ 'after reenable' }, api.nvim_buf_get_lines(0, 0, -1, true))\n     end)\n\n-    -- Renaming must move the subscription to the new file.\n-    local renamed = t.tmpname()\n-    write_file(renamed, 'renamed\\n')\n-    api.nvim_buf_set_name(0, renamed)\n-    n.exec_lua([[require('nvim.autoread')._set_debounce(5000)]])\n-    write_file(renamed, 'changed renamed\\n')\n-    retry(nil, 3000, function()\n-      eq(1, api.nvim_get_option_value('busy', { buf = 0 }))\n-    end)\n+    -- Renaming moves the watcher to the new file.\n+    api.nvim_buf_set_name(0, t.tmpname())\n+    eq(api.nvim_buf_get_name(0), watched_path())\n\n-    -- A nonexistent name stops the subscription and clears pending work.\n-    api.nvim_buf_set_name(0, renamed .. '.missing')\n+    -- Renaming to a nonexistent file stops the watcher.\n+    api.nvim_buf_set_name(0, api.nvim_buf_get_name(0) .. '.missing')\n     eq(false, is_watching())\n-    retry(nil, 3000, function()\n-      eq(0, api.nvim_get_option_value('busy', { buf = 0 }))\n-    end)\n   end)\n\n   it('handles file deletion gracefully', function()\n```\n\n</details>",
