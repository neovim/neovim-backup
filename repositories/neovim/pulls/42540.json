            "author_association": "MEMBER",
            "body": "This is actually a  weak test, because `client:is_stopped()` is true immediately after `stop()` is called, so the test would pass even if the server were never terminated. Checking `client.rpc.is_closing()` or `on_exit`, would be stronger.\n",
            "commit_id": "331db6180d657174b73b59b8cdd30944af98326d",
            "copilot_code_review_sources": [],
            "created_at": "2026-11-01T14:41:22Z",
            "diff_hunk": "@@ -216,6 +216,16 @@ describe('LSP', function()\n           end)\n         )\n       end)\n+\n+      -- Nvim exit also stops clients still waiting for initialize. #42440\n+      exec_lua(function()\n+        local client_id = assert(_G.test__start_client())\n+        local client = assert(vim.lsp.get_client_by_id(client_id))\n+        assert(not client.initialized)\n+        assert(not client:is_stopped())\n+        vim.api.nvim_exec_autocmds('VimLeavePre', { modeline = false })\n+        assert(client:is_stopped(), 'Uninitialized client was not stopped on exit')",
            "html_url": "https://github.com/neovim/neovim/pull/42540#discussion_r4436085302",
