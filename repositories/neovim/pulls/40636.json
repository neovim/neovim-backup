            "diff_hunk": "@@ -0,0 +1,115 @@\n+# Build and test the WebAssembly port, and publish a downloadable demo bundle.\n+#\n+# One job, one build, three deliverables:\n+#   1. the wasm build itself (the composite action runs the per-variant boot\n+#      gate as part of wasm/build-nvim.sh — a variant that doesn't boot clean\n+#      fails the build);\n+#   2. the test run: the Node smoke tests (wasm/web: e2e + treesitter) plus a\n+#      sample of the upstream functional suite executed against the wasm\n+#      engine (wasm/test/run-functional.sh);\n+#   3. the demo: wasm/web/build-site.sh assembled and uploaded as the\n+#      `nvim-wasm-demo` artifact — a flat directory that runs on any static\n+#      file server. Download, unzip, `python3 -m http.server`, open the page.\n+name: wasm\n+\n+on:\n+  push:\n+    branches: [main, master]\n+    paths:\n+      - 'wasm/**'\n+      - 'src/**'\n+      - 'cmake.deps/**'\n+      - 'cmake/**'\n+      - 'runtime/**'\n+      - 'CMakeLists.txt'\n+      - '.github/workflows/wasm.yml'\n+      - '.github/actions/build-wasm/**'\n+  pull_request:\n+    paths:\n+      - 'wasm/**'\n+      - 'src/**'\n+      - 'cmake.deps/**'\n+      - 'cmake/**'\n+      - 'runtime/**'\n+      - 'CMakeLists.txt'\n+      - '.github/workflows/wasm.yml'\n+      - '.github/actions/build-wasm/**'\n+  workflow_dispatch:\n+\n+concurrency:\n+  group: wasm-${{ github.ref }}\n+  cancel-in-progress: true\n+\n+jobs:\n+  build-test-demo:\n+    runs-on: ubuntu-latest\n+    timeout-minutes: 90\n+    env:\n+      EM_VERSION: 3.1.69\n+    steps:\n+      - uses: actions/checkout@v4",
