    "body": "@zeertzjq does this wrap #14061 up?",
    "closed_at": "2026-07-07T01:41:11Z",
    "comment_data": [
        {
            "_links": {
                "html": {
                    "href": "https://github.com/neovim/neovim/pull/40620#discussion_r3532649284"
                },
                "pull_request": {
                    "href": "https://api.github.com/repos/neovim/neovim/pulls/40620"
                },
                "self": {
                    "href": "https://api.github.com/repos/neovim/neovim/pulls/comments/3532649284"
                }
            },
            "author_association": "MEMBER",
            "body": "I don't think it's a good idea to spawn a extra child Nvim just to test this. I think it's better to use `:redir`:\r\n```diff\r\ndiff --git a/test/functional/terminal/buffer_spec.lua b/test/functional/terminal/buffer_spec.lua\r\nindex 74ceb3a26d..7e28e0d8a4 100644\r\n--- a/test/functional/terminal/buffer_spec.lua\r\n+++ b/test/functional/terminal/buffer_spec.lua\r\n@@ -240,6 +240,9 @@ describe(':terminal buffer', function()\r\n \r\n   it('requires bang (!) to close a running job #15402', function()\r\n     eq('Vim(wqall):E948: Job still running (add ! to end the job)', pcall_err(command, 'wqall'))\r\n+    command('redir => g:wqall_out | silent! wqall | redir END')\r\n+    matches('E948:', api.nvim_get_var('wqall_out'))\r\n+    not_matches('E676:', api.nvim_get_var('wqall_out'))\r\n     for _, cmd in ipairs({ 'bdelete', '%bdelete', 'bwipeout', 'bunload' }) do\r\n       matches(\r\n         '^Vim%('\r\n```",
            "commit_id": "191fbd8fcccec7d5dbcee0b9e2ad170d072d4349",
            "created_at": "2026-07-06T23:31:41Z",
            "diff_hunk": "@@ -256,6 +257,13 @@ describe(':terminal buffer', function()\n     n.expect_exit(command, 'wqall!')\n   end)\n \n+  it('does not try to write hidden terminal buffers after :wqa fails', function()\n+    local p = n.spawn_wait({ args = { '+terminal', '+new', '+wqa', '+qall!' } })\n+    matches('E948: Job still running %(add %! to end the job%)', p.stderr)\n+    not_matches('E676:', p.stderr)\n+    eq(0, p.status)\n+  end)\n+",
            "html_url": "https://github.com/neovim/neovim/pull/40620#discussion_r3532649284",
            "id": 3532649284,
