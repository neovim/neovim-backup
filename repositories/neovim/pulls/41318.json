        {
            "author_association": "MEMBER",
            "body": "Benchmark shows ~1.1 ns/write ( nanosecond scale, i.e. very small):\r\n\r\n```\r\n                JIT (~1.1 ns/write)   interpreted (~10.2 ns/write)\r\n  1 ms                  0.9M writes                    100k writes\r\n 10 ms                    9M writes                      1M writes\r\n100 ms                   91M writes                     10M writes\r\n\r\n                                  JIT          interpreted\r\nPos,   2 fields (row+col)   10 ms @ 4.5M      10 ms @ 490k\r\nRange, 4 fields             10 ms @ 2.3M      10 ms @ 245k\r\n```\r\n\r\nConstructing a `vim.Pos` costs *37 ns*; the mutation penalty is *1.1 ns* — 3% of the cost of the object being mutated.\r\n\r\nIf a \"long-lived\" object is mutated in a tight loop:\r\n\r\n- A scanner advancing `pos.col` per byte over a 10 MB buffer: 10M writes → **11 ms** JIT'd.\r\n- Same loop interpreted (cold, before the trace compiles): 10M × 10.2 ns → 102 ms.\r\n\r\nEscape hatch if a hot loop ever does need it: `p[1] = v` bypasses `__newindex`. So a hot inner loop can opt out.\r\n\r\n\r\n<details>\r\n<summary>bench script</summary>\r\n\r\n```lua\r\n--   VIMRUNTIME=$PWD/runtime build/bin/nvim --clean -l pos_bench.lua\r\n\r\nlocal n = 2e6\r\nlocal k = 512 -- distinct objects, so no store is redundant\r\n\r\nlocal tmp = vim.fn.tempname()\r\nvim.fn.mkdir(tmp, 'p')\r\n\r\nlocal function load_side(patched)\r\n  local src = tmp .. (patched and '/new.lua' or '/base.lua')\r\n  if patched then\r\n    vim.fn.writefile(vim.fn.readfile('runtime/lua/vim/pos.lua'), src)\r\n  else\r\n    local r = vim.system({ 'git', 'show', 'HEAD:runtime/lua/vim/pos.lua' }, { text = true }):wait()\r\n    assert(r.code == 0, r.stderr)\r\n    vim.fn.writefile(vim.split(r.stdout, '\\n'), src)\r\n  end\r\n  return assert(loadfile(src))()\r\nend\r\n\r\nlocal base, patch = load_side(false), load_side(true)\r\n\r\n-- 1. Does a numeric access reach __newindex at all?  Exact; no timing involved.\r\nlocal hits = 0\r\nlocal orig = patch.__newindex\r\npatch.__newindex = function(...)\r\n  hits = hits + 1\r\n  return orig(...)\r\nend\r\nlocal function count(fn)\r\n  hits = 0\r\n  fn()\r\n  return hits\r\nend\r\nlocal p = patch(0, 1, 2)\r\nprint('__newindex calls (patched vim.Pos):')\r\nprint(('  p[1] = 9     %d'):format(count(function()\r\n  p[1] = 9\r\nend)))\r\nprint(('  p[2] = 9     %d'):format(count(function()\r\n  p[2] = 9\r\nend)))\r\nprint(('  p.row = 9    %d'):format(count(function()\r\n  p.row = 9\r\nend)))\r\npatch.__newindex = orig\r\n\r\n-- 2. What does the named-field write cost?\r\n--\r\n-- The loop is built with load() once per side.  Sharing one prototype would make LuaJIT compile a\r\n-- trace for whichever module ran first and then re-specialise it for the second, which shows up as\r\n-- a ~2x penalty on the second side no matter which one it is.\r\nlocal bench_src = [[\r\n  local M, named, n, k = ...\r\n  local objs = {}\r\n  for i = 1, k do\r\n    objs[i] = M(0, i % 3, i % 11)\r\n  end\r\n  local best = math.huge\r\n  for _ = 1, 7 do\r\n    collectgarbage('collect')\r\n    local t0 = vim.uv.hrtime()\r\n    local j, acc = 0, 0\r\n    for i = 1, n do\r\n      j = j + 1\r\n      if j > k then j = 1 end\r\n      local q = objs[j]\r\n      if named then q.row = i else q[1] = i end\r\n      acc = acc + q[1]  -- fold the result in, else LuaJIT sinks the store\r\n    end\r\n    _G._sink = acc\r\n    best = math.min(best, (vim.uv.hrtime() - t0) / n)\r\n  end\r\n  return best\r\n]]\r\n\r\nlocal function bench(M, named)\r\n  return assert(load(bench_src))(M, named, n, k)\r\nend\r\n\r\nlocal nb, np = bench(base, true), bench(patch, true)\r\nlocal rb, rp = bench(base, false), bench(patch, false)\r\n\r\nprint('')\r\nprint(('%-24s %8s %8s %9s'):format('write, 2M iters', 'base', 'patch', 'delta'))\r\nlocal fmt = '%-24s %6.2fns %6.2fns %+8.1f%%'\r\nprint(fmt:format('p.row = i  (named)', nb, np, (np / nb - 1) * 100))\r\nprint(fmt:format('p[1]  = i  (numeric)', rb, rp, (rp / rb - 1) * 100))\r\nprint('')\r\nprint(('=> named writes cost %+.1f ns/op; numeric access is untouched.'):format(np - nb))\r\nprint(('=> ~%.0fM named writes to add 10ms.'):format(10e6 / (np - nb) / 1e6))\r\n```\r\n\r\n\r\n</details>",
