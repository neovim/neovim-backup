            "author_association": "MEMBER",
            "body": "this is the only way I could find to test this and... it's pretty convoluted.\n\ni'm fine with removing (not adding) this test at all - no strong opinions",
            "commit_id": "7cfe988c7f94957d3f8a7f4a64412534f0427209",
            "created_at": "2026-07-06T03:06:40Z",
            "diff_hunk": "@@ -256,6 +257,114 @@ describe(':Man', function()\n     os.remove(actual_file)\n   end)\n \n+  it('reuses hidden man buffers until the effective width changes', function()\n+    if t.is_os('win') then\n+      pending('N/A for Windows')\n+      return\n+    end\n+\n+    local fake_dir = tmpname(false)\n+    local bin_dir = fake_dir .. '/bin'\n+    t.mkdir(fake_dir)\n+    t.mkdir(bin_dir)\n+\n+    local fake_man = bin_dir .. '/man'\n+    local log = fake_dir .. '/log'\n+    finally(function()\n+      os.remove(fake_man)\n+      os.remove(log)\n+      vim.uv.fs_rmdir(bin_dir)\n+      vim.uv.fs_rmdir(fake_dir)\n+    end)\n+    write_file(",
