        {
            "author_association": "CONTRIBUTOR",
            "body": "On my local box, limited to 4 cpu, a cold debug build takes ~11s, versus ~2s on a warm ccache, and a cold release build takes 26s, versus ~19s on a warm ccache. It's not a lot in the grand scheme of things, but it's ~free.",
            "created_at": "2026-08-25T15:12:52Z",
            "html_url": "https://github.com/neovim/neovim/pull/41486#issuecomment-5412542087",
