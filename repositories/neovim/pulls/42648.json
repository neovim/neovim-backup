            "body": "gsub() ...? and `[=[...]=]` to reduce the escaping",
            "commit_id": "004b8bb442ce0286406a9bbcdb855dfce232edd1",
            "copilot_code_review_sources": [],
            "created_at": "2026-11-02T10:08:04Z",
            "diff_hunk": "@@ -239,6 +239,8 @@ local function glob2regpat(glob)\n     placeholder,\n     'g'\n   )\n+  -- EditorConfig negates a character class with \"[!seq]\", Vim with \"[^seq]\".\n+  glob1 = vim.fn.substitute(glob1, '\\\\\\\\\\\\@<!\\\\[!', '[^', 'g')",
