    "comment_regular_data": [
        {
            "author_association": "MEMBER",
            "body": "Haven't looked at the code here, but want to suggest a general expectation: think about enhancements to `nvim_open_win` which can be generalized, and re-used by this feature, instead of building internal-only logic which is not re-usable.\r\n\r\nI have a local branch which adds `relative=auto` to lift some of logic that was internal-only for 'previewpopup', into `nvim_open_win`.",
            "created_at": "2026-08-02T09:21:07Z",
            "html_url": "https://github.com/neovim/neovim/pull/40943#issuecomment-5156820223",
            "id": 5156820223,
