            "body": "> IMO just checking that `traceback` is a function is\r\n\r\nthe code cost is nearly the same though:\r\n\r\n```diff\r\ndiff --git c/src/nvim/lua/executor.c i/src/nvim/lua/executor.c\r\nindex 5ac5e7203b01..bf330cfc3126 100644\r\n--- c/src/nvim/lua/executor.c\r\n+++ i/src/nvim/lua/executor.c\r\n@@ -328,13 +328,10 @@ static int nlua_no_traceback(lua_State *lstate)\r\n /// @param[in] nresults Number of results the function returns.\r\n int nlua_pcall(lua_State *lstate, int nargs, int nresults)\r\n {\r\n-  // Detect broken `_G.debug` (by user code). #41504\r\n   lua_getglobal(lstate, \"debug\");\r\n-  if (lua_istable(lstate, -1)) {\r\n-    lua_getfield(lstate, -1, \"traceback\");\r\n-    lua_remove(lstate, -2);\r\n-  }\r\n-  bool no_traceback = !lua_isfunction(lstate, -1);  // `_G.debug.traceback` is a function?\r\n+  lua_getfield(lstate, -1, \"traceback\");\r\n+  lua_remove(lstate, -2);\r\n+  bool no_traceback = !lua_isfunction(lstate, -1);  // `_G.debug.traceback` is a function? #41504\r\n   if (no_traceback) {\r\n     lua_pop(lstate, 1);\r\n     lua_pushcfunction(lstate, nlua_no_traceback);\r\ndiff --git c/test/functional/lua/overrides_spec.lua i/test/functional/lua/overrides_spec.lua\r\nindex 88344d2916cc..bc04848fc33b 100644\r\n--- c/test/functional/lua/overrides_spec.lua\r\n+++ i/test/functional/lua/overrides_spec.lua\r\n@@ -195,8 +195,8 @@ describe('_G.debug', function()\r\n   end)\r\n \r\n   it('if broken, Nvim reports it instead of crashing #41504', function()\r\n-    -- If user code breaks _G.debug somehow, basic Nvim features should still work.\r\n-    for _, override in ipairs({ '_G.debug = nil', 'debug.traceback = nil', '_G.debug = {}' }) do\r\n+    -- If user code breaks _G.debug, basic Nvim features should still work.\r\n+    for _, override in ipairs({ 'debug.traceback = nil', '_G.debug = {}' }) do\r\n       clear()\r\n       eq(\r\n         true,\r\n```",
