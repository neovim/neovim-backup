                }
            },
            "author_association": "MEMBER",
            "body": "we have a util for this\n\n```c\n    char *p = (char *)pat + 8;\n    return getdigits_int(&p, false, 0);\n  }\n```",
            "commit_id": "8bba9f9e2d5d89eb9a339e9357e5be18dc7a4484",
            "created_at": "2026-06-26T23:58:55Z",
            "diff_hunk": "@@ -2592,7 +2592,11 @@ int aupat_get_buflocal_nr(const char *pat, int patlen)\n \n     // \"<buffer=123>\"\n     if (skipdigits(pat + 8) == pat + patlen - 1) {\n-      return atoi(pat + 8);\n+      char *endptr;\n+      long nr = strtol(pat + 8, &endptr, 10);\n+      if (nr >= 0 && nr <= INT_MAX) {\n+        return (int)nr;",
