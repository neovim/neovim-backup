            },
            "author_association": "MEMBER",
            "body": "start the skip msg with N/A, that will group it to avoid noise in the \"pending\" list. This should not be listed as \"pending\" because it is not \"fixable\".\n\n```suggestion\n    t.skip(not t.is_os('mac'), 'N/A pbcopy provider is only used on macOS')\n```",
            "commit_id": "5725779f55bcfbdf0c51383f0fdbea81000f80ed",
            "copilot_code_review_sources": [],
            "created_at": "2026-10-31T23:06:09Z",
            "diff_hunk": "@@ -206,6 +206,27 @@ describe('clipboard', function()\n     eq('', eval('provider#clipboard#Error()'))\n   end)\n \n+  it('pbcopy/pbpaste use UTF-8 if $LANG has no codeset #11432', function()\n+    t.skip(not t.is_os('mac'), 'pbcopy provider is only used on macOS')",
