            },
            "author_association": "MEMBER",
            "body": "You can reduce repetition with something along these lines\n\n```lua\nlocal function reject_vim_nil(fn)\n  return function(t, ...)\n    if t == vim.NIL then\n      error('attempt to iterate vim.NIL', 2)\n    end\n\n    return fn(t, ...)\n  end\nend\n\n_G.pairs  = reject_vim_nil(pairs)\n_G.ipairs = reject_vim_nil(ipairs)\n_G.next   = reject_vim_nil(next)\n```",
            "commit_id": "45f2880a5a350256fd312c0d3f7952cb71f20170",
            "created_at": "2026-07-16T15:11:16Z",
            "diff_hunk": "@@ -99,3 +99,27 @@ if vim.api and not vim.is_thread() then\n   require('vim._core.editor')\n   require('vim._core.system')\n end\n+\n+local _pairs = pairs\n+_G.pairs = function(t)\n+  if t == vim.NIL then\n+    error('attempt to iterate vim.NIL', 2)\n+  end\n+  return _pairs(t)\n+end\n+\n+local _ipairs = ipairs\n+_G.ipairs = function(t)\n+  if t == vim.NIL then\n+    error('attempt to iterate vim.NIL', 2)\n+  end\n+  return _ipairs(t)\n+end\n+\n+local _next = next\n+_G.next = function(t, k)\n+  if t == vim.NIL then\n+    error('attempt to iterate vim.NIL', 2)\n+  end\n+  return _next(t, k)\n+end",
