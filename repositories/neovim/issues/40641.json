    "comment_data": [
        {
            "author_association": "MEMBER",
            "body": "The approach in vim-dirvish, which I think was very successful (conceptually/intuitively), is to simply allow, and encourage, modifications to the dir buffer. Just need to provide well-defined hooks. Then users (and maybe some builtin defaults) can easily sort the contents in arbitrary ways.",
            "created_at": "2026-07-08T18:12:52Z",
            "html_url": "https://github.com/neovim/neovim/issues/40641#issuecomment-4917842111",
            "id": 4917842111,
            "issue_url": "https://api.github.com/repos/neovim/neovim/issues/40641",
            "minimized": null,
