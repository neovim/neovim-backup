    "comment_data": [
        {
            "author_association": "MEMBER",
            "body": "This is because the channel's `detach` flag is set (same as if `:detach!` with bang \"!\" was invoked): https://github.com/neovim/neovim/blob/299ca3c81e2d181160c56989e7255d9930f5bd34/src/nvim/api/ui.c#L130-L131\n\nWe should probably restore its original value after restart completes.",
            "created_at": "2026-10-06T10:46:01Z",
            "html_url": "https://github.com/neovim/neovim/issues/42250#issuecomment-6014594243",
