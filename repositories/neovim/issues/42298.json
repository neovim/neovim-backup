            "author_association": "NONE",
            "body": "```lua\n_G.test = function()\n  local start = vim.api.nvim_buf_get_mark(0, \"[\")\n  local _end = vim.api.nvim_buf_get_mark(0, \"]\")\n  vim.print({ start, _end })\n  vim.cmd(\"normal! `[v`]d\")\nend\n\nvim.keymap.set(\"n\", \"d\", function()\n  vim.o.operatorfunc = \"v:lua.test\"\n  vim.api.nvim_create_autocmd(\"CmdAtom\", {\n    callback = function(ev)\n      vim.print(ev.data)\n      return true\n    end,\n  })\n  return \"g@\"\nend, { expr = true })\n\nlocal a = true\n\n_G.motion = function()\n  if not a then\n    return\n  end\n  vim.cmd(\"normal! vh\")\n  a = false\nend\n\nvim.keymap.set(\"o\", \"e\", \"<cmd>lua _G.motion()<cr>\")\n\n```\n\n`dede`: The two branches of the `motion` function produce the same result, making it difficult to distinguish between them based on the `[ ]` position markers (even though the two branches have different meanings).\n```\n{\n  changed = true,\n  cmd = \"<Cmd>\",\n  keys = \"g@<80><fd>hlua _G.motion()\\n\",\n  lhs = \"de\",\n  moved = true,\n  operator = \"g@\",\n  pos = { 1, 19 },\n  type = \"operator\",\n  undoseq = 6\n}\n```\n\nIf `v:motion` were available, could it provide `<80><fd>hlua _G.motion()\\n`?\n\nEven if that were the case, it would not resolve the aforementioned dilemma.\n\n",
