        {
            "author_association": "NONE",
            "body": "> > This forces me to press K again to get into the window and the result is that the native markdown rendering vanishes.\n> \n> That's literally how you can scroll it with the keyboard.\n> \n> This was discussed previously, and documented in https://github.com/neovim/neovim/pull/30347\n\nNo need to think about as this solves it:\n\n    local function scroll_hover(dir)\n      for _, winid in ipairs(vim.api.nvim_list_wins()) do\n        if vim.api.nvim_win_get_config(winid).relative ~= \"\" then\n          vim.api.nvim_win_call(winid, function()\n            vim.cmd(dir == \"down\" and \"normal! \\x06\" or \"normal! \\x02\")\n          end)\n          return true\n        end\n      end\n      return false\n    end\n\n    vim.keymap.set(\"n\", \"<C-f>\", function()\n      if not scroll_hover(\"down\") then\n        vim.cmd(\"normal! \\x06\")\n      end\n    end)\n    vim.keymap.set(\"n\", \"<C-b>\", function()\n      if not scroll_hover(\"up\") then\n        vim.cmd(\"normal! \\x02\")\n      end\n    end)",
