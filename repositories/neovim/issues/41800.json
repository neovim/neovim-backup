    "comment_data": [
        {
            "author_association": "MEMBER",
            "body": "I think `a` and `o` from vim-dirvish are pretty solid. \n\nWe may not need `<plug>` aliases or another \"custom way\" interface, if they have trivial spellings (`:split <c-a>`, `:vsplit <c-a>`, ...).\n\n",
