        {
            "author_association": "CONTRIBUTOR",
            "body": "Thanks for the great work guys. A few thoughts:\n\nI am a heavy `c-f` user during `input()`. My use case is a personal user command `:Compile`  that prompts for input. I use `c-f` to edit the command line arguments or to browse/search through my input history via `?`. I will probably cry if it's gone without a workaround.\n\nI feel an approach like #40463 is a little hacky.\n\nI'm of the opinion of that \"I want to edit/browse my input history\" is common  enough that maybe it's useful to have by default without necessarily reviving the whole cmdwin machinery. \n\nAs a compromise, what if we had a `vim.ui.input` implementation that provides something similar to `c-f`?\n\nHere's something I hacked up to illustrate the idea\n\n<details>\n<summary>Click to expand code</summary>\n\n\n```lua\nlocal M = {}\n\nM.history = {\n    \"ls -l\",\n    \"date\",\n    \"echo 123\",\n    \"alacritty\",\n    \"nvim --version\",\n}\n\nlocal function close(input, win, on_confirm)\n    if vim.api.nvim_win_is_valid(win) then\n        vim.api.nvim_win_close(win, true)\n    end\n    if input and input ~= '' then\n        table.insert(M.history, input)\n    end\n    vim.cmd.stopinsert()\n    on_confirm(input)\nend\n\nlocal function set_line(buf, win, s)\n    vim.api.nvim_buf_set_lines(buf, 0, 1, false, { s or '' })\n    vim.api.nvim_win_set_cursor(win, { 1, #(s or '') })\nend\n\n-- c-f replacement\nlocal function open_history_window(buf, win, opts, on_confirm)\n    local cur = vim.api.nvim_buf_get_lines(buf, 0, 1, false)[1]\n    vim.api.nvim_win_close(win, true)\n    vim.cmd.stopinsert()\n\n    local lines = M.history\n    if cur ~= \"\" then\n        lines = vim.deepcopy(M.history)\n        table.insert(lines, cur)\n    end\n\n    local hbuf = vim.api.nvim_create_buf(false, true)\n    vim.api.nvim_buf_set_lines(hbuf, 0, -1, false, lines)\n\n    local hwin = vim.api.nvim_open_win(hbuf, true, {\n        relative = 'cursor', row = 1, col = 0, width = 60, height = 10,\n        style = 'minimal', border = 'rounded', title = 'history (edit + <CR>)',\n    })\n    vim.wo[hwin].number = true\n\n    local last_row = #lines\n    local last_col = math.max(#lines[last_row], 0)\n    vim.api.nvim_win_set_cursor(hwin, { last_row, last_col })\n\n    vim.keymap.set({ 'n', 'i' }, '<CR>', function()\n        local row = vim.api.nvim_win_get_cursor(hwin)[1]\n        local chosen = vim.api.nvim_buf_get_lines(hbuf, row - 1, row, false)[1]\n        vim.api.nvim_win_close(hwin, true)\n        close(chosen, win, on_confirm)\n    end, { buffer = hbuf })\nend\n\nfunction M.input(opts, on_confirm)\n    opts = opts or {}\n    local buf = vim.api.nvim_create_buf(false, true)\n    vim.api.nvim_buf_set_lines(buf, 0, -1, false, { opts.default or '' })\n\n    local win = vim.api.nvim_open_win(buf, true, {\n        relative = 'cursor', row = 1, col = 0,\n        width = math.max(40, #(opts.prompt or '') + 20), height = 1,\n        style = 'minimal', border = 'rounded', title = opts.prompt,\n    })\n    vim.cmd.startinsert()\n\n    local idx = #M.history + 1\n\n    vim.keymap.set({ 'i', 'n' }, '<CR>', function()\n        local input = vim.api.nvim_buf_get_lines(buf, 0, 1, false)[1]\n        close(input, win, on_confirm)\n    end, { buffer = buf })\n\n    vim.keymap.set({ 'i', 'n' }, '<Esc>', function()\n        close(nil, win, on_confirm)\n    end, { buffer = buf })\n\n    vim.keymap.set({ 'i', 'n' }, '<C-p>', function()\n        if idx > 1 then\n            idx = idx - 1\n            set_line(buf, win, M.history[idx])\n        end\n    end, { buffer = buf })\n\n    vim.keymap.set({ 'i', 'n' }, '<C-n>', function()\n        idx = math.min(idx + 1, #M.history + 1)\n        set_line(buf, win, M.history[idx])\n    end, { buffer = buf })\n\n    vim.keymap.set({ 'i', 'n' }, '<C-f>', function()\n        open_history_window(buf, win, opts, on_confirm)\n    end, { buffer = buf })\nend\n\nvim.ui.input = M.input\n\nreturn M\n```\n</details>\n\nWhat do you think of that approach?",
