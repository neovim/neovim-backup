            "author_association": "CONTRIBUTOR",
            "body": "> \"Neovim executable\"? `nvim` ?\r\n> \r\n> please review what your AI did. i'm not going to review it until you do.\r\n\r\nSorry, this was meant to be opened as a draft while I did a larger pass over it myself today wittling down the pointless stuff it decided to do (like most of the CLI wiring)",
            "commit_id": "cf9ff9aa64615eae1847982a190bed57ceb6c166",
            "created_at": "2026-07-23T11:21:20Z",
            "diff_hunk": "@@ -0,0 +1,180 @@\n+using System;\n+using System.Diagnostics;\n+using System.IO;\n+using System.Threading.Tasks;\n+using Nvim.Client.Generator;\n+\n+if (args.Length < 1)\n+{\n+  Console.Error.WriteLine(\n+    \"Usage: Nvim.Client.Generator.Cli <output-directory> [nvim] [--doxygen-source <neovim-source-directory>]\"\n+  );\n+  return 2;\n+}\n+\n+var output = args[0];\n+var executable = \"nvim\";\n+string? doxygenSource = null;\n+\n+for (var index = 1; index < args.Length; index++)\n+{\n+  if (args[index] == \"--doxygen-source\")\n+  {\n+    if (++index >= args.Length)\n+      throw new ArgumentException(\n+        \"--doxygen-source requires a Neovim source directory.\"\n+      );\n+    doxygenSource = args[index];\n+    continue;\n+  }\n+\n+  if (executable != \"nvim\")\n+    throw new ArgumentException(\"Only one Neovim executable may be supplied.\");",
